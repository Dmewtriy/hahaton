# Use `python -m korsik.cli init --demo` to generate random keys.
KORSIK_ENVIRONMENT=development
KORSIK_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters
KORSIK_DATABASE_URL=sqlite:///./data/korsik.db
KORSIK_DATA_DIR=data
KORSIK_ENABLE_DEMO=true
KORSIK_TRANSPORT=mock
KORSIK_MAX_TOKEN=
KORSIK_MAX_BOT_NAME=
KORSIK_MAX_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
KORSIK_MAX_BASE_URL=https://platform-api2.max.ru
KORSIK_MAX_CA_FILE=certs/russian_trusted_root_ca.pem
# stub — встроенная заглушка; http — внешний ML/RAG (соседний hakaton/scripts/ml_service.py)
KORSIK_ML_MODE=stub
# С хоста: http://127.0.0.1:9000 ; из Docker: http://host.docker.internal:9000
# ML должен слушать 0.0.0.0 (по умолчанию в ml_service.py), а не только 127.0.0.1.
KORSIK_ML_BASE_URL=http://127.0.0.1:9000
KORSIK_ML_TOKEN=local-rag-token
KORSIK_ML_TIMEOUT_SECONDS=120
POSTGRES_PASSWORD=replace-with-random-alphanumeric-password

# MAX Mini App: fill after obtaining a public HTTPS origin and registering /app.
KORSIK_WEBAPP_PUBLIC_URL=
KORSIK_ALLOW_LOCAL_ADMIN_LOGIN=true
KORSIK_WEBAPP_AUTH_MAX_AGE_SECONDS=3600

KORSIK_ENABLE_OPTIONAL=true

KORSIK_ENABLE_MANAGEMENT=true
